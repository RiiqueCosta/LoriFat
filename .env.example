# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GEMINI_MODEL: (opcional) modelo Gemini usado para ler propostas.
# Padrão: gemini-3.5-flash
# VITE_GEMINI_MODEL="gemini-3.5-flash"

# VITE_RECAPTCHA_SITE_KEY: chave de site do reCAPTCHA Enterprise registrada no Firebase App Check
# (necessária no site publicado se o App Check estiver exigido).
# VITE_RECAPTCHA_SITE_KEY=""

# VITE_APPCHECK_DEBUG_TOKEN: (opcional, só desenvolvimento) token de depuração fixo do App Check.
# VITE_APPCHECK_DEBUG_TOKEN=""
