rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'luizcosta8604@gmail.com';
    }

    function isAuthorizedMember(userId) {
      return isOwner(userId) || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)) && 
        get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data.ownerUid == userId
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidRecord(data, userId) {
      return data.keys().hasAll(['id', 'type', 'dateCreated', 'ownerId']) &&
             data.keys().size() >= 4 &&
             data.id is string && data.id.size() <= 128 &&
             data.type in ['invoice', 'quote', 'client', 'expense', 'note', 'recurring', 'service'] &&
             data.dateCreated is string &&
             data.ownerId == userId &&
             (data.keys().hasAny(['items']) ? data.items is list && data.items.size() <= 100 : true) &&
             (data.keys().hasAny(['discount']) ? data.discount is number && data.discount >= 0 : true) &&
             (data.keys().hasAny(['notes']) ? data.notes is string && data.notes.size() <= 5000 : true);
    }

    function optString(data, key, max) {
      return !data.keys().hasAny([key]) || (data[key] is string && data[key].size() <= max);
    }

    function isValidConfig(data) {
      return data.keys().hasAll(['companyName', 'theme']) &&
             data.companyName is string && data.companyName.size() <= 100 &&
             data.theme in ['light', 'dark'] &&
             optString(data, 'companyPhone', 30) &&
             optString(data, 'companyEmail', 100) &&
             optString(data, 'companyCnpj', 30) &&
             optString(data, 'companyAddress', 200) &&
             optString(data, 'logo', 400000) &&
             optString(data, 'pixKey', 100) &&
             optString(data, 'pixName', 25) &&
             optString(data, 'pixCity', 15) &&
             optString(data, 'invoiceTerms', 2000) &&
             optString(data, 'quoteTerms', 2000) &&
             optString(data, 'chargeMessage', 2000);
    }

    function isValidAllowedUser(data) {
      return data.keys().hasAll(['email', 'role', 'addedAt', 'ownerUid']) &&
             data.email is string && data.role in ['collaborator', 'admin'] &&
             data.ownerUid == request.auth.uid;
    }

    // Resource Paths
    match /allowed_users/{email} {
      // Allow public GET so registration can verify authorization
      // This is safe as 'list' is still restricted to admins
      allow get: if true; 
      allow list: if isAdminEmail();
      allow create, update: if isAdminEmail() && isValidAllowedUser(incoming());
      allow delete: if isAdminEmail();
    }

    match /users/{userId} {
      // Each user can only read and write their own data, OR if they are an authorized collaborator.
      allow read, write: if isAuthorizedMember(userId);

      match /records/{recordId} {
        allow get: if isAuthorizedMember(userId) && isValidId(recordId);
        allow list: if isAuthorizedMember(userId);
        allow create: if isAuthorizedMember(userId) && isValidId(recordId) && isValidRecord(incoming(), userId) &&
          (!incoming().keys().hasAny(['updatedAt']) || incoming().updatedAt == request.time) &&
          (!incoming().keys().hasAny(['createdBy']) || incoming().createdBy == request.auth.uid);
        allow update: if isAuthorizedMember(userId) && isValidId(recordId) && isValidRecord(incoming(), userId) && (
          // Edição livre dos campos do registro, exceto os de identidade.
          !incoming().diff(existing()).affectedKeys().hasAny(['id', 'type', 'ownerId', 'createdBy']) &&
          (!incoming().diff(existing()).affectedKeys().hasAny(['updatedAt']) || incoming().updatedAt == request.time)
        );
        allow delete: if isAuthorizedMember(userId) && isValidId(recordId);
      }

      // Aparelhos que recebem notificações (token do Firebase Cloud Messaging).
      match /devices/{deviceId} {
        allow read, delete: if isAuthorizedMember(userId) && isValidId(deviceId);
        allow create, update: if isAuthorizedMember(userId) && isValidId(deviceId) &&
          incoming().keys().hasAll(['token', 'prefs', 'uid']) &&
          incoming().token is string && incoming().token.size() <= 4096 &&
          incoming().prefs is map &&
          incoming().uid == request.auth.uid;
      }

      match /settings/config {
        allow get: if isAuthorizedMember(userId);
        allow write: if isAuthorizedMember(userId) && isValidConfig(incoming());
      }
    }
  }
}
